# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN AUTHENTICATION
# Mandatory for accessing /admin. No default password exists. If unset, admin login is disabled.
ADMIN_SECRET_KEY="replace_with_your_strong_admin_secret_key"

# QIKINK POD INTEGRATION
# Leave empty until you obtain credentials from Qikink. The store functions smoothly with COD.
# When QIKINK_SANDBOX_MODE="true", it connects to https://sandbox.qikink.com/api and maps to test SKUs.
# When QIKINK_SANDBOX_MODE="false", it connects to https://api.qikink.com/api and uses your store SKU.
QIKINK_CLIENT_ID=""
QIKINK_CLIENT_SECRET=""
QIKINK_SANDBOX_SECRET=""
QIKINK_SANDBOX_MODE="true"

# RAZORPAY PAYMENT GATEWAY
# If left empty, Razorpay payment option is hidden and COD remains available.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# PHONEPE PAYMENT GATEWAY
# If left empty, PhonePe payment option is hidden and COD remains available.
PHONEPE_MERCHANT_ID=""
PHONEPE_SALT_KEY=""
PHONEPE_SALT_INDEX="1"
PHONEPE_ENV="UAT"

# EMAIL NOTIFICATIONS (Optional - Resend)
RESEND_API_KEY=""
FROM_EMAIL="orders@rangrez.in"

# PERSISTENT DATABASE (Firebase Cloud Firestore via Admin SDK)
# By default, RANGREZ persists store data locally to disk in data/store.json and images in /uploads.
# To connect persistent Cloud Firestore across stateless container redeploys:
#
# OPTION 1 (RECOMMENDED - Entire JSON service account key in one variable):
# The server automatically parses the JSON and fixes all private_key newlines.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"rangrez-clothing",...}'
#
# OPTION 2 (Alternative - Three separate variables; ignored if FIREBASE_SERVICE_ACCOUNT_JSON is set):
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# SERVER
PORT="3000"

